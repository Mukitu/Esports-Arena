# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Integration Configuration
# Obtain your Supabase URL and Anon Key from the Supabase Project Dashboard -> Settings -> API
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Groq API Integration (For Diganta AI Gaming Assistant)
# Recommended: Set GROQ_API_KEY in Supabase Edge Function Secrets (`supabase secrets set GROQ_API_KEY=your_key`)
GROQ_API_KEY="your_groq_api_key_here"

# Optional client-side fallback if testing locally without Supabase CLI
VITE_GROQ_API_KEY="your_groq_api_key_here"
